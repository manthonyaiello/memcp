with "config/memcp_config.gpr";
project Memcp is

   for Source_Dirs use ("src/", "config/");
   for Object_Dir use "obj/" & Memcp_Config.Build_Profile;
   for Create_Missing_Dirs use "True";
   for Exec_Dir use "bin";
   for Main use ("main.adb");

   package Compiler is
      for Default_Switches ("Ada") use Memcp_Config.Ada_Compiler_Switches & ("-gnatyM99", "-gnatys");
      --  Needed to instantiate the json generics here; see gnat.adc.
      for Local_Configuration_Pragmas use "gnat.adc";
   end Compiler;

   package Builder is
      --  alire.toml declares the executable name "memcp"; the main subprogram
      --  is main.adb (procedure Main) so that library unit name "Memcp" is
      --  free for the Memcp package hierarchy (Memcp.Env, Memcp.Json, ...).
      for Executable ("main.adb") use "memcp";
   end Builder;

   package Binder is
      for Switches ("Ada") use ("-Es"); --  Symbolic traceback
   end Binder;

   package Install is
      for Artifacts (".") use ("share");
   end Install;

   --  GNATdoc (issue #22). This is the root of the doc site, so its HTML lands
   --  in docs/api/ rather than under obj/, where the default would put it and
   --  `alr clean` would take it away. docs/api/ is itself gitignored -- CI
   --  uploads it as a build artifact rather than committing generated HTML.
   --
   --  Everything else about the run lives in scripts/check-docs.sh, which is
   --  both the durable record of those choices and the gate that enforces them
   --  (`make docs` to report, `make docs-check` to fail on a finding). It has to
   --  be a script rather than attributes here, for two reasons:
   --
   --    * No `Documentation` attribute governs the comment STYLE, and this
   --      project is --style=gnat: the doc block sits BELOW the declaration,
   --      with @param/@return/@enum/@formal mandatory. A block left above its
   --      declaration is silently ignored and the entity reported undocumented.
   --    * gnatdoc walks the whole dependency graph, so the report also carries
   --      ~5,100 warnings of third-party noise (SPARKlib, json-spark, the
   --      Alire-generated *_config.ads) that is NOT ours to document and cannot
   --      be excluded portably -- Excluded_Project_Files needs paths to project
   --      files that live in machine-specific Alire cache locations, so the
   --      scope filter has to be by unit name, in the script.
   package Documentation is
      for Output_Dir ("html") use "docs/api";
   end Documentation;

end Memcp;
