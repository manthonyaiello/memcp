--  Smoke driver for the binding; withing the library crate inherits its
--  Linker_Options and the vendored C in libSqlite_Vec_Spark.a. No AUnit, so it
--  runs as soon as the crate builds. -gnata makes the binding's Pre/Post and
--  the driver's asserts executable.
with "../sqlite_vec_spark.gpr";

project Sqlite_Smoke is

   for Source_Dirs use (".");
   for Object_Dir use "obj";
   for Exec_Dir use ".";
   for Main use ("sqlite_smoke.adb");
   for Create_Missing_Dirs use "True";

   package Compiler is
      for Default_Switches ("Ada") use ("-g", "-gnata", "-gnatwa", "-gnatyM99", "-gnatys");
   end Compiler;

   package Binder is
      for Switches ("Ada") use ("-Es");
   end Binder;

end Sqlite_Smoke;
